{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "http-fetch",
  "description": "Allow HTTP requests for calendar and network services",
  "windows": [
    "*"
  ],
  "permissions": [
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://*/*" },
        { "url": "http://*/*" }
      ]
    }
  ]
}
